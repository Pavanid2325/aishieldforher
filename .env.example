# Copy to .env locally. Never commit runtime secrets. URL-encode DB password.
RUNTIME_ENV_FILE=.env.local
APP_ENV=development
DATABASE_URL=postgresql://shield:local-only-change-me@postgres:5432/shield
POSTGRES_USER=shield
POSTGRES_DB=shield
POSTGRES_PASSWORD=local-only-change-me
REDIS_URL=redis://redis:6379/0
# Empty preserves legacy unauthenticated local clients. Production requires token.
API_TOKEN=
# Required for /ops endpoints; use a random long token for production.
DIAGNOSTIC_TOKEN=local-diagnostics-change-me
# No existing provider exists. Fake delivery is local/CI only; production must be false.
ALERTS_ENABLED=true
ALERT_PROVIDER=fake
FAKE_ALERT_FAIL=false
FAKE_INFERENCE=false
# Mount this directory containing toxicity/, voice_model/, scream_model/, vosk-model-small-en-in-0.4/.
MODEL_ASSET_DIR=./assets/models
DB_POOL_SIZE=2
GUNICORN_WORKERS=1
TRUST_PROXY=true
# Production: full ECR digest reference, git commit SHA, and RDS certificate bundle.
BACKEND_IMAGE=shield:local
RELEASE_ID=development
RDS_CA_PATH=/run/rds/global-bundle.pem
# Used by production nginx TLS mount (fullchain.pem and privkey.pem).
TLS_DIR=/opt/aishield/tls
RDS_CA_DIR=/opt/aishield/rds
PUBLIC_BASE_URL=https://shield.example.com
